# ────────────────────────────────────────────────────────────────
# GitHub App credentials
# Register at: https://github.com/settings/apps/new
# After creating the App, GitHub gives you:
#   - App ID                → GITHUB_APP_ID
#   - Client ID             → GITHUB_APP_CLIENT_ID
#   - Client Secret         → GITHUB_APP_CLIENT_SECRET (generate one)
#   - Private key           → download .pem, set GITHUB_APP_PRIVATE_KEY_PATH
#                             OR paste the PEM contents into GITHUB_APP_PRIVATE_KEY
#   - Webhook secret        → set when registering, also goes here
# App slug is the URL-safe name; used to build the install URL.
# ────────────────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=dypol
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./dypol.private-key.pem
# GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

GITHUB_API_BASE=https://api.github.com

# ────────────────────────────────────────────────────────────────
# Personal Access Token for public-org (open-source) workspaces.
# STRONGLY RECOMMENDED if you offer public workspaces at all — it is the
# single biggest factor in whether they work:
#
#            anonymous (no PAT)      with a PAT
#   REST     60 req/hr               5,000 req/hr
#   Search   10 req/min              30 req/min
#
# That budget is SHARED by every public workspace and every user, unlike an
# App install which gets its own 5,000+/hr. Anonymously, a couple of
# dashboard loads exhaust the hour. RAG indexing of public workspaces is
# also skipped entirely without a PAT (one request per file would eat the
# whole budget). Needs only `public_repo` scope — or no scope at all.
# ────────────────────────────────────────────────────────────────
GITHUB_PAT=

# ────────────────────────────────────────────────────────────────
# LLM providers — the agent is provider-agnostic (LangChain init_chat_model).
# Set any subset of keys; AGENT_PROVIDER_ORDER decides fallback priority.
# Default order leads with the keys you most likely have (Gemini → Groq).
# To lead with Claude, add ANTHROPIC_API_KEY and put anthropic first.
# ────────────────────────────────────────────────────────────────
AGENT_PROVIDER_ORDER=gemini,groq

# Groq — fast, generous free tier (30 RPM, 8k tokens/min on gpt-oss-120b).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Anthropic (Claude) — optional. Wired + ready; dormant until a key is set.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001

# OpenAI — optional. Wired + ready; dormant until a key is set.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Agent tuning (optional — sensible defaults shown)
# AGENT_TEMPERATURE=0.2
# AGENT_MAX_TOKENS=1200
# AGENT_MAX_TOOL_TURNS=6
# AGENT_HISTORY_TOKEN_BUDGET=12000

# ────────────────────────────────────────────────────────────────
# Observability — Langfuse agent tracing/evals (optional). With no keys the
# agent runs unchanged. Set both to get per-step traces, token/cost accounting,
# LLM-as-judge + regression evals in the Langfuse UI. Get keys at langfuse.com
# (or self-host). uv pip install langfuse  (already installed).
# ────────────────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ────────────────────────────────────────────────────────────────
# Error monitoring — Sentry (optional). No DSN ⇒ completely inert.
# Create a (free) project at sentry.io — the GitHub Student Pack bumps
# limits to 50K errors + 100K transactions for a year. Needs the extra:
#   uv pip install -e ".[sentry]"
# Traces sampling is % of requests sent as performance transactions —
# keep low in prod, it consumes the transactions quota.
# ────────────────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0

# ────────────────────────────────────────────────────────────────
# Cost & reliability controls
#   DAILY_TOKEN_BUDGET: per-(user, org) daily output-token ceiling; 0 = off.
#   CIRCUIT_*: short-circuit a provider after N consecutive failures.
#   AUDIT_LOG_ENABLED: structured, secret-redacted per-turn audit log in Mongo.
# ────────────────────────────────────────────────────────────────
DAILY_TOKEN_BUDGET=0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
AUDIT_LOG_ENABLED=true

# ────────────────────────────────────────────────────────────────
# Online web search (optional). Tavily preferred; falls back to DuckDuckGo
# (no key) when WEB_SEARCH_ENABLED is true and no Tavily key is set.
# Tavily needs the `web` extra:  uv pip install -e ".[web]"
# ────────────────────────────────────────────────────────────────
WEB_SEARCH_ENABLED=true
# TAVILY_API_KEY=

# ────────────────────────────────────────────────────────────────
# Hybrid RAG / semantic search (optional but ON by default). Works out of
# the box using the Gemini key above as the embedder — no extra key needed.
# Set RAG_ENABLED=false to run in pure-agentic mode (live GitHub API only).
#   VECTOR_BACKEND:      chroma (embedded, default) | pgvector | qdrant
#   EMBED_*_PROVIDER:    auto | gemini | voyage | openai | local | none
# Heavier options need extras:
#   voyage embeddings → uv pip install -e ".[embed-voyage]" + VOYAGE_API_KEY
#   fully-local embed → uv pip install -e ".[embed-local]" (pulls torch)
#   pgvector backend  → uv pip install -e ".[vector-pg]" + PGVECTOR_DSN
#   qdrant backend    → uv pip install -e ".[vector-qdrant]" + QDRANT_URL
# ────────────────────────────────────────────────────────────────
RAG_ENABLED=true
VECTOR_BACKEND=chroma
CHROMA_PATH=./.chroma
EMBED_CODE_PROVIDER=auto
EMBED_PROSE_PROVIDER=auto
# VOYAGE_API_KEY=
# PGVECTOR_DSN=
# QDRANT_URL=
# QDRANT_API_KEY=

# ────────────────────────────────────────────────────────────────
# URLs — change these when you move from localhost to a real domain.
# WEB_BASE_URL is where users land after auth (the Next.js app).
# APP_BASE_URL is this backend's public URL (used for OAuth redirect_uri
# and cookie-setting). It MUST be a subdomain of the frontend's domain
# (e.g. api.dypol.dev with www.dypol.dev) so session cookies are first-party
# and browsers don't block them cross-site.
# ────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────
# Session — random 32+ bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotate this and every user is logged out (intentional).
# ────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=dypol_session
SESSION_MAX_AGE_DAYS=14

# ────────────────────────────────────────────────────────────────
# Mongo
# ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=dypol

# ────────────────────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# ────────────────────────────────────────────────────────────────
# Cache TTLs (seconds)
# ────────────────────────────────────────────────────────────────
CACHE_TTL_REPOS=300
CACHE_TTL_PRS=120
CACHE_TTL_MEMBERS=600
