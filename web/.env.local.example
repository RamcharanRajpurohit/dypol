# Backend URL — change for staging/prod.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# PostHog product analytics (optional). No token ⇒ SDK never initializes.
# Project token + region host from posthog.com → project settings.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry error monitoring (optional). No DSN ⇒ SDK stays disabled.
# DSN from sentry.io → project settings → Client Keys.
# NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload in CI only (readable prod stack traces):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
